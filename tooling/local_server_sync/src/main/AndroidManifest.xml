<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to read the current WiFi BSSID so the user can mark a network
         as "home WiFi" for bulk sync, and so the scheduler can match against
         it at runtime. ACCESS_FINE_LOCATION is required on API 27+; without
         it the OS returns a placeholder BSSID. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

</manifest>
